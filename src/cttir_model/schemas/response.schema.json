{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CTTIR model proposal v1",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "needs_input",
        "unsupported",
        "failed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "r_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60000
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "protocol_version",
    "request_id",
    "status",
    "summary",
    "r_code",
    "evidence_ids",
    "assumptions",
    "missing_inputs",
    "limitations"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "unsupported",
              "failed",
              "needs_input"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "r_code": {
            "type": "null"
          }
        }
      }
    }
  ]
}
