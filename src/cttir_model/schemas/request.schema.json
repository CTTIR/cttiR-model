{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CTTIR specialist request v1",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "enum": [
        "select_workflow",
        "propose_r_code",
        "explain_api",
        "review_r_code"
      ]
    },
    "language": {
      "enum": [
        "de",
        "en"
      ]
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "package_pins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "version",
          "repository"
        ],
        "additionalProperties": false
      }
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_contract": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "object_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "experimental_unit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "columns",
        "object_classes",
        "experimental_unit"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_output_tokens": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8192
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      },
      "required": [
        "max_output_tokens",
        "timeout_seconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol_version",
    "request_id",
    "task",
    "language",
    "instruction",
    "corpus_id",
    "package_pins",
    "evidence_ids",
    "input_contract",
    "budget"
  ],
  "additionalProperties": false
}
