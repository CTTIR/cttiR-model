  "exports": [
    {
      "name": "audit",
      "signature": "audit(path = NULL, scope = c(\"installation\", \"knowledge\", \"project\"), repair = FALSE, output = NULL, strict = FALSE, live = FALSE)"
    },
    {
      "name": "doctor",
      "signature": "doctor(path = NULL)"
    },
    {
      "name": "project",
      "signature": "project(name, type, goal, path = getwd(), config = NULL, options = list(), dry_run = FALSE)"
    },
    {
      "name": "resources",
      "signature": "resources(query = NULL, domain = NULL, repository = NULL, path = NULL, limit = 50L)"
    },
    {
      "name": "sync",
      "signature": "sync(path = \".\", config = NULL, options = list(), dry_run = TRUE)"
    },
    {
      "name": "validate_config",
      "signature": "validate_config(config)"
    },
    {
      "name": "validate_spec",
      "signature": "validate_spec(spec)"
    }
  ],
  "capabilities": {
    "offline_project_scaffold": true,
    "provider_registration": false,
    "model_inference": false,
    "knowledge_export_api": false,
    "workflow_adapter_execution": false,
    "workflow_dependency_migration": false
