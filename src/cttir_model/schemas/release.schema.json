{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CTTIR publishable artifact manifest v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "artifact_kind": {
      "enum": [
        "lora_adapter",
        "merged",
        "gguf"
      ]
    },
    "base_repo_id": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "effective_base_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "gate_report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "release_qualified",
        "publication_prepared",
        "published"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "hf_repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "visibility": {
      "enum": [
        "private",
        "public"
      ]
    },
    "remote_commit": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "model_name",
    "artifact_kind",
    "base_repo_id",
    "base_revision",
    "effective_base_fingerprint",
    "source_commit",
    "corpus_id",
    "dataset_manifest_sha256",
    "benchmark_id",
    "gate_report_sha256",
    "status",
    "files",
    "hf_repo",
    "visibility",
    "remote_commit"
  ],
  "additionalProperties": false
}
