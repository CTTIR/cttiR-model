{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CTTIR training record v1",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "group_id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "enum": [
        "select_workflow",
        "propose_r_code",
        "explain_api",
        "review_r_code"
      ]
    },
    "language": {
      "enum": [
        "de",
        "en"
      ]
    },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "package_pins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "version",
          "repository"
        ],
        "additionalProperties": false
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_response": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "CTTIR model proposal v1",
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "proposed",
            "needs_input",
            "unsupported",
            "failed"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "r_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60000
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "protocol_version",
        "request_id",
        "status",
        "summary",
        "r_code",
        "evidence_ids",
        "assumptions",
        "missing_inputs",
        "limitations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unsupported",
                  "failed",
                  "needs_input"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "r_code": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "validation_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "train",
        "development",
        "test",
        "unassigned"
      ]
    },
    "synthetic_data": {
      "type": "boolean"
    },
    "review_status": {
      "enum": [
        "draft",
        "reviewed",
        "rejected"
      ]
    },
    "rights_status": {
      "enum": [
        "approved",
        "pending",
        "restricted",
        "rejected"
      ]
    },
    "source_manifest_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "record_id",
    "group_id",
    "task",
    "language",
    "messages",
    "package_pins",
    "evidence_ids",
    "corpus_id",
    "expected_response",
    "validation_id",
    "split",
    "synthetic_data",
    "review_status",
    "rights_status",
    "source_manifest_id"
  ],
  "additionalProperties": false
}
